Bootstrap: docker
From: alpine:latest

%labels
    Author abeelen
    Description "Native Alpine Singularity image building GILDAS from official tarballs (musl patches included)"

%environment
    # Default runtime environment (can be overridden at build time via env vars)
    export GILDAS_RELEASE=${GILDAS_RELEASE:-jan26a}
    export GILDAS_URL=${GILDAS_URL:-https://www.iram.fr/~gildas/dist}
    export PIIC_URL=${PIIC_URL:-https://www.iram.fr/~gildas/dist}
    export GAG_USE_SANITIZE=${GAG_USE_SANITIZE:-no}
    export MAKE_JOBS=${MAKE_JOBS:-$(nproc)}
    export IMAGER_VERSION=${IMAGER_VERSION:-last}
    export IMAGER_URL=${IMAGER_URL:-https://share.oasu.u-bordeaux.fr/imager}
    export WITH_IMAGER=${WITH_IMAGER:-1}
    export SINGULARITY_SHELL=/bin/bash

# Source patches shared by all recipes (kept as files, applied with
# patch(1) so they stay reviewable diffs instead of inline edits).
# %setup runs on the host (repo root), so plain relative paths work;
# %files is avoided: its staging proved unreliable (missing file at %post).
%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/patches
    cp patches/*.patch ${SINGULARITY_ROOTFS}/opt/patches/

%post
    set -eu

    # Only cfitsio comes from edge/testing (same as Dockerfile.alpine).
    echo "@testing http://dl-cdn.alpinelinux.org/alpine/edge/testing" >> /etc/apk/repositories

    # Slim runtime dependencies (mirrors the gildas_worker stage).
    apk add --no-cache \
        bash \
        curl \
        libx11 \
        libpng \
        fftw \
        gtk+2.0 \
        python3 \
        ipython \
        py3-pip \
        py3-numpy \
        py3-scipy \
        py3-emcee \
        py3-matplotlib \
        cfitsio@testing \
        libgomp \
        gcompat

    # No py3-astropy in Alpine repos: install via pip.
    pip install --break-system-packages astropy

    # Build dependencies
    apk add --no-cache \
        libx11-dev \
        libpng-dev \
        fftw-dev \
        cfitsio-dev@testing \
        python3-dev \
        gtk+2.0-dev \
        gfortran \
        groff \
        build-base \
        linux-headers \
        patch

    # Build and install GILDAS
    # Defaults for build-time variables: the host environment does NOT
    # propagate into %post, so pass them as SINGULARITYENV_* when building
    # (plain VAR=... prefixes are silently dropped, then set -u aborts).
    : "${GILDAS_RELEASE:=oct26a}"
    : "${GILDAS_URL:=https://www.iram.fr/~gildas/dist}"
    : "${PIIC_URL:=https://www.iram.fr/~gildas/dist}"
    : "${GAG_USE_SANITIZE:=no}"
    : "${MAKE_JOBS:=$(nproc)}"
    release="${GILDAS_RELEASE}"
    gildas_url="${GILDAS_URL}"
    piic_url="${PIIC_URL}"

    export GAG_USE_SANITIZE

    cd /
    curl -fSL --retry 3 --connect-timeout 20 \
        "${gildas_url}/gildas-src-${release}.tar.xz" -o "/tmp/gildas-src-${release}.tar.xz"
    curl -fSL --retry 3 --connect-timeout 20 \
        "${gildas_url}/gildas-doc-${release}.tar.xz" -o "/tmp/gildas-doc-${release}.tar.xz" || true
    tar xJf "/tmp/gildas-src-${release}.tar.xz"
    rm -f "/tmp/gildas-src-${release}.tar.xz"

    # Source patches (same files as the Docker images, staged via %setup
    # above). One loop serves both the GILDAS and IMAGER trees: they share
    # the same layout. patch(1) fails loudly on mismatch.
    for _p in musl-sysc-cache musl-unistd musl-sighandler clic-ungate sic-foreground; do
        (cd "gildas-src-${release}" && patch -p1 --forward < "/opt/patches/${_p}.patch") \
            || { echo "ERROR: patch ${_p} failed (GILDAS tree)" >&2; exit 1; }
    done
    cd /

    bash -c "cd gildas-src-${release} && \
        GAG_SEARCH_PATH=/usr/lib source admin/gildas-env.sh -o openmp && \
        make -j ${MAKE_JOBS} && make install"

    rm -rf "gildas-src-${release}"

    if [ -f "/tmp/gildas-doc-${release}.tar.xz" ]; then
        cd "/gildas-exe-${release}" && tar xJf "/tmp/gildas-doc-${release}.tar.xz"
        rm -f "/tmp/gildas-doc-${release}.tar.xz"
    fi

    # Standalone IMAGER (https://imager.oasu.u-bordeaux.fr, self-contained
    # tree built like GILDAS) at canonical /imager-exe. Skipped when
    # WITH_IMAGER=0.
    : "${IMAGER_VERSION:=last}"
    : "${IMAGER_URL:=https://share.oasu.u-bordeaux.fr/imager}"
    : "${WITH_IMAGER:=1}"
    mkdir -p /imager-exe
    if [ "${WITH_IMAGER}" = "1" ]; then
        unset gagsrcdir gagexedir gagadmdir || true
        cd /tmp
        curl -fSL --retry 3 --connect-timeout 20 \
            "${IMAGER_URL}/imager-${IMAGER_VERSION}.tgz" -o imager-dl.tgz
        imdir="$(tar tzf imager-dl.tgz | head -n 1 | cut -d/ -f1)"
        case "${imdir}" in imager-src-*) ;; *) echo "ERROR: unexpected imager top dir ${imdir}" >&2; exit 1;; esac
        echo "${imdir#imager-src-}" > /etc/imager-version
        tar xzf imager-dl.tgz -C /
        rm -f imager-dl.tgz
        # Same patches as the GILDAS tree (same loop, IMAGER tree mirrors
        # the layout; verified against oct26).
        imroot="/${imdir}"
        for _p in musl-sysc-cache musl-unistd musl-sighandler clic-ungate sic-foreground; do
            if [ "${_p}" = "clic-ungate" ] && [ ! -f "${imroot}/packages/clic/Makefile" ]; then
                echo "SKIP ${_p} (no clic package in this tree)" >&2; continue
            fi
            (cd "${imroot}" && patch -p1 --forward < "/opt/patches/${_p}.patch") \
                || { echo "ERROR: patch ${_p} failed (IMAGER tree)" >&2; exit 1; }
        done
        IMDIR="${imdir}" JOBS="${MAKE_JOBS}" bash -c '
            set -ex
            unset gagsrcdir gagexedir gagadmdir || true
            cd "/${IMDIR}"
            cd Admin-Source && source substitute.compile.sh && cd ..
            GAG_SEARCH_PATH=/usr/lib source admin/imager-env.sh -o openmp
            export gagexedir=/imager-exe
            make -j "${JOBS}" && make install
        '
        rm -rf "/${imdir}"
    else
        echo "Skipping IMAGER (WITH_IMAGER=${WITH_IMAGER})"
        echo "${IMAGER_VERSION:-none} (unresolved)" > /etc/imager-version
    fi

    # Optional PIIC installation (warns when the tarball is missing instead
    # of silently producing a GILDAS-only image)
    cd /
    if curl -fSL --retry 3 --connect-timeout 20 \
            "${piic_url}/piic-exe-${release}.tar.xz" -o "/tmp/piic-exe-${release}.tar.xz"; then
        tar xJf "/tmp/piic-exe-${release}.tar.xz" && rm -f "/tmp/piic-exe-${release}.tar.xz"
        echo "${release}" > /etc/piic-version
    else
        echo "WARNING: no piic-exe-${release}.tar.xz at ${piic_url}, skipping PIIC" >&2
        echo "none (unresolved)" > /etc/piic-version
    fi

    # Auto-detect GAG_EXEC_SYSTEM (musl layout differs from glibc).
    gag_exec_system="$(ls -1 "/gildas-exe-${release}/" | grep -E 'gfortran-openmp|gfortran|generic|musl|alpine' | head -n 1 || true)"
    if [ -z "${gag_exec_system}" ]; then gag_exec_system='x86_64-generic'; fi

    # Single environment file, shared by the runscript and appruns
    # (same layout as /etc/gildas-env.sh in the Docker images).
    {
        echo "# Gildas base environment"
        echo "export GAG_ROOT_DIR=/gildas-exe-${release}"
        echo "export GAG_EXEC_SYSTEM=${gag_exec_system}"
        echo 'if [ -f "$GAG_ROOT_DIR/etc/bash_profile" ]; then'
        echo '  . "$GAG_ROOT_DIR/etc/bash_profile"'
        echo 'fi'
    } > /etc/gildas-env.sh

    # Direct-access wrappers (same rule as the Docker images): every
    # program shipped by the PIIC tree but missing from GILDAS (or IMAGER)
    # gets a self-contained /usr/local/bin wrapper selecting the PIIC tree.
    # Never shadows a GILDAS program of the same name.
    if [ -f "/piic-exe-${release}/etc/bash_profile" ]; then
        piic_exec="$(ls -1 "/piic-exe-${release}/" | grep -E 'gfortran-openmp|gfortran|generic|musl|alpine' | head -n 1 || true)"
        if [ -z "${piic_exec}" ]; then piic_exec='x86_64-generic'; fi
        for _bin in "/piic-exe-${release}/${piic_exec}/bin/"*; do
            _prog="$(basename "${_bin}")"
            if [ ! -x "/gildas-exe-${release}/${gag_exec_system}/bin/${_prog}" ] && [ ! -e "/usr/local/bin/${_prog}" ]; then
                {
                    echo '#!/bin/sh'
                    echo "# ${_prog}: runs from the PIIC tree (/piic-exe-${release})."
                    echo "export GAG_ROOT_DIR=/piic-exe-${release}"
                    echo "export GAG_EXEC_SYSTEM=${piic_exec}"
                    echo 'if [ -f "$GAG_ROOT_DIR/etc/bash_profile" ]; then'
                    echo '  . "$GAG_ROOT_DIR/etc/bash_profile"'
                    echo 'fi'
                    echo 'exec "$GAG_EXEC_DIR/bin/'"${_prog}"'" "$@"'
                } > "/usr/local/bin/${_prog}"
                chmod +x "/usr/local/bin/${_prog}"
            fi
        done
    fi

    # Same for the standalone IMAGER tree at canonical /imager-exe.
    if [ -f /imager-exe/etc/bash_profile ]; then
        im_exec="$(ls -1 /imager-exe/ | grep -E 'gfortran-openmp|gfortran|generic|musl|alpine' | head -n 1 || true)"
        if [ -z "${im_exec}" ]; then im_exec='x86_64-generic'; fi
        echo "${im_exec}" > /etc/imager-exec-system
        for _bin in "/imager-exe/${im_exec}/bin/"*; do
            _prog="$(basename "${_bin}")"
            if [ ! -x "/gildas-exe-${release}/${gag_exec_system}/bin/${_prog}" ] && [ ! -e "/usr/local/bin/${_prog}" ]; then
                {
                    echo '#!/bin/sh'
                    echo "# ${_prog}: runs from the standalone IMAGER tree (/imager-exe)."
                    echo 'export GAG_ROOT_DIR=/imager-exe'
                    echo "export GAG_EXEC_SYSTEM=${im_exec}"
                    echo 'if [ -f "$GAG_ROOT_DIR/etc/bash_profile" ]; then'
                    echo '  . "$GAG_ROOT_DIR/etc/bash_profile"'
                    echo 'fi'
                    echo 'exec "$GAG_EXEC_DIR/bin/'"${_prog}"'" "$@"'
                } > "/usr/local/bin/${_prog}"
                chmod +x "/usr/local/bin/${_prog}"
            fi
        done
    fi

    # Keep interactive shells working too
    cat /etc/gildas-env.sh >> /etc/bash.bashrc

    # Trim build-time dependencies to reduce final SIF size.
    apk del \
        libx11-dev \
        libpng-dev \
        fftw-dev \
        cfitsio-dev \
        python3-dev \
        gtk+2.0-dev \
        gfortran \
        groff \
        build-base \
        linux-headers || true

    # NOTE: never glob /tmp or /var/tmp here: under `singularity build`
    # those hold the builder's own busy mounts (resolv.conf, proc, sys
    # ...) and rm aborts on them. /tmp only ever holds our own downloads,
    # all removed right after use above.
    rm -rf /usr/share/doc /usr/share/man /root/.cache

%runscript
    # Source the GILDAS environment (same file as in the Docker images).
    if [ -f /etc/gildas-env.sh ]; then
        # shellcheck disable=SC1091
        . /etc/gildas-env.sh
    fi

    if [ "$#" -eq 0 ]; then
        exec /bin/bash -i
    else
        exec "$@"
    fi

%apprun astro
    . /etc/gildas-env.sh 2>/dev/null || true
    exec astro "$@"

%apprun clic
    . /etc/gildas-env.sh 2>/dev/null || true
    exec clic "$@"

%apprun class
    . /etc/gildas-env.sh 2>/dev/null || true
    exec class "$@"

%apprun cube
    . /etc/gildas-env.sh 2>/dev/null || true
    exec cube "$@"

%apprun flux
    . /etc/gildas-env.sh 2>/dev/null || true
    exec flux "$@"

%apprun greg
    . /etc/gildas-env.sh 2>/dev/null || true
    exec greg "$@"

%apprun hershey
    . /etc/gildas-env.sh 2>/dev/null || true
    exec hershey "$@"

%apprun imager
    . /etc/gildas-env.sh 2>/dev/null || true
    exec imager "$@"

%apprun mapping
    . /etc/gildas-env.sh 2>/dev/null || true
    exec mapping "$@"

%apprun orbit
    . /etc/gildas-env.sh 2>/dev/null || true
    exec orbit "$@"

%apprun classic-read
    . /etc/gildas-env.sh 2>/dev/null || true
    exec classic-read "$@"

%apprun point
    . /etc/gildas-env.sh 2>/dev/null || true
    exec point "$@"

%apprun sic
    . /etc/gildas-env.sh 2>/dev/null || true
    exec sic "$@"

%apprun piic
    . /etc/gildas-env.sh 2>/dev/null || true
    exec piic "$@"

%apprun viewer
    . /etc/gildas-env.sh 2>/dev/null || true
    exec viewer "$@"
