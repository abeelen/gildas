Bootstrap: docker
From: abeelen/gildas:latest

%labels
    Author abeelen
    Description "GILDAS Singularity image bootstrapped from abeelen/gildas:latest"

%environment
    # Use bash as default shell. The container's /etc/bash.bashrc,
    # configured in the Docker image, will be sourced automatically
    # by interactive bash shells, so we don't force BASH_ENV here.
    export SINGULARITY_SHELL=/bin/bash

%runscript
    # Behave like the Docker ENTRYPOINT (/etc/gildas-env.sh ships in the
    # Docker image; /etc/bash.bashrc alone does not set up GILDAS).
    if [ -f /etc/gildas-env.sh ]; then
        # shellcheck disable=SC1091
        . /etc/gildas-env.sh
    fi

    if [ "$#" -eq 0 ]; then
        exec /bin/bash -i
    else
        exec "$@"
    fi

%apprun astro
    . /etc/gildas-env.sh 2>/dev/null || true
    exec astro "$@"

%apprun clic
    . /etc/gildas-env.sh 2>/dev/null || true
    exec clic "$@"

%apprun flux
    . /etc/gildas-env.sh 2>/dev/null || true
    exec flux "$@"

%apprun hershey
    . /etc/gildas-env.sh 2>/dev/null || true
    exec hershey "$@"

%apprun orbit
    . /etc/gildas-env.sh 2>/dev/null || true
    exec orbit "$@"

%apprun classic-read
    . /etc/gildas-env.sh 2>/dev/null || true
    exec classic-read "$@"

%apprun point
    . /etc/gildas-env.sh 2>/dev/null || true
    exec point "$@"

%apprun class
    . /etc/gildas-env.sh 2>/dev/null || true
    exec class "$@"

%apprun cube
    . /etc/gildas-env.sh 2>/dev/null || true
    exec cube "$@"

%apprun mapping
    . /etc/gildas-env.sh 2>/dev/null || true
    exec mapping "$@"

%apprun sic
    . /etc/gildas-env.sh 2>/dev/null || true
    exec sic "$@"

%apprun greg
    . /etc/gildas-env.sh 2>/dev/null || true
    exec greg "$@"

%apprun imager
    . /etc/gildas-env.sh 2>/dev/null || true
    exec imager "$@"

%apprun piic
    . /etc/gildas-env.sh 2>/dev/null || true
    exec piic "$@"

%apprun viewer
    . /etc/gildas-env.sh 2>/dev/null || true
    exec viewer "$@"

