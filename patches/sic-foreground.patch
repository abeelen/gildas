     setpgid( 0, 0);                     /* This should also work on Linux */
 #endif
+    /* Stay in the terminal foreground group when interactive: setpgrp() above moves us out of it, and the first terminal read would then suspend the process (SIGTTIN). Restoring our own group is a no-op when already foreground and fails silently without a terminal. */
+    if (isatty(STDIN_FILENO)) {
+        /* tcsetpgrp() issued from a background group raises SIGTTOU and stops
+           us before doing anything: ignore it around the call (restored after). */
+        void (*saved_ttou)(int) = signal(SIGTTOU, SIG_IGN);
+        tcsetpgrp(STDIN_FILENO, getpgrp());
+        signal(SIGTTOU, saved_ttou);
+    }
