# syntax=docker/dockerfile:1
FROM alpine:latest AS gildas_worker

# This Dockerfile builds the (default) Alpine-based abeelen/gildas images.
# Debian images are the opt-in variant built from docker/Dockerfile.debian
# (`-debian` tags).
#
# Recommended tags when building:
#   docker build -f docker/Dockerfile.alpine \
#     --target gildas \
#     --build-arg release=jan26a \
#     -t abeelen/gildas:jan26a .
#
#   docker build -f docker/Dockerfile.alpine \
#     --target gildas-piic \
#     --build-arg release=jan26a \
#     -t abeelen/gildas:jan26a-piic .
#
# Add `-t abeelen/gildas:latest` / `-t abeelen/gildas:latest-piic` for the
# newest release (`gildas_release.py` does all of this automatically).

# Tracking alpine:latest (rolling). Only cfitsio comes from edge/testing.
# The package list is shared with apptainer/gildas-native-alpine.def.
RUN --mount=type=bind,source=packages/alpine-runtime.txt,target=/tmp/alpine-runtime.txt \
    --mount=type=cache,target=/var/cache/apk,sharing=locked \
    echo "@testing http://dl-cdn.alpinelinux.org/alpine/edge/testing" >> /etc/apk/repositories && \
    apk add --no-cache $(cat /tmp/alpine-runtime.txt)

# No py3-astropy in Alpine repos (checked on 3.24): install via pip.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --break-system-packages astropy

LABEL org.opencontainers.image.title="GILDAS runtime (alpine)" \
      org.opencontainers.image.source="https://github.com/abeelen/gildas"


FROM gildas_worker AS gildas_builder

# Same shared build list as the native recipe; ccache is Docker-only.
RUN --mount=type=bind,source=packages/alpine-build.txt,target=/tmp/alpine-build.txt \
    --mount=type=cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache $(cat /tmp/alpine-build.txt) ccache

ENV PATH="/usr/lib/ccache/bin:${PATH}" \
    CC="ccache gcc" \
    CXX="ccache g++" \
    FC="ccache gfortran"


FROM gildas_builder AS builder

# Source patches shared by all recipes (kept as files, applied with
# patch(1) so they stay reviewable diffs instead of inline edits).
COPY patches/ /tmp/patches/

ARG release
ENV release=${release}

# Base URL for GILDAS (can be overridden at build time)
ARG GILDAS_URL=https://www.iram.fr/~gildas/dist

# SANITIZE option can trigger crashes; keep disabled by default
ARG GAG_USE_SANITIZE=no
ENV GAG_USE_SANITIZE=${GAG_USE_SANITIZE}

# Defaults to host CPU count when empty. Override with --build-arg MAKE_JOBS=N.
ARG MAKE_JOBS=""

WORKDIR /

# 1. Separate download layer: cached unless release/URL changes.
RUN set -eu -o pipefail; \
    curl -fSL --retry 3 --connect-timeout 20 \
      "$GILDAS_URL/gildas-src-$release.tar.xz" -o "/tmp/gildas-src-$release.tar.xz"; \
    curl -fSL --retry 3 --connect-timeout 20 \
      "$GILDAS_URL/gildas-doc-$release.tar.xz" -o "/tmp/gildas-doc-$release.tar.xz" || true; \
    tar xJf "/tmp/gildas-src-$release.tar.xz"; \
    rm -f "/tmp/gildas-src-$release.tar.xz"

# 2. Source patches (musl compatibility, clic ungate, SIC foreground),
# isolated in their own layer so a patch change does not force a
# re-download. One loop serves both the GILDAS and IMAGER trees: they
# share the same layout. patch(1) fails loudly on mismatch.
RUN set -eu -o pipefail; \
    cd "gildas-src-$release"; \
    for _p in musl-sysc-cache musl-unistd musl-sighandler clic-ungate sic-foreground; do \
      patch -p1 --forward < "/tmp/patches/${_p}.patch" || { echo "ERROR: patch ${_p} failed" >&2; exit 1; }; \
    done

# 3. Compile layer with ccache.
RUN --mount=type=cache,target=/root/.ccache \
    set -eu -o pipefail; \
    JOBS="${MAKE_JOBS:-$(nproc)}"; \
    cd "gildas-src-$release" && \
    bash -c "GAG_SEARCH_PATH=/usr/lib source admin/gildas-env.sh -o openmp && make -j $JOBS && make install"; \
    rm -rf "gildas-src-$release"; \
    if [ -f "/tmp/gildas-doc-$release.tar.xz" ]; then \
      cd "gildas-exe-$release" && tar xJf "/tmp/gildas-doc-$release.tar.xz" && rm -f "/tmp/gildas-doc-$release.tar.xz"; \
    fi; \
    ccache -s || true

# Standalone IMAGER (https://imager.oasu.u-bordeaux.fr, self-contained tree
# built like GILDAS). Installed to canonical /imager-exe. Skipped when
# WITH_IMAGER=0 (an empty /imager-exe keeps the COPY below valid).
ARG IMAGER_VERSION=last
ARG IMAGER_URL=https://share.oasu.u-bordeaux.fr/imager
ARG WITH_IMAGER=1

RUN set -eu -o pipefail; \
    mkdir -p /imager-exe; \
    if [ "${WITH_IMAGER}" != "1" ]; then \
      echo "Skipping IMAGER (WITH_IMAGER=${WITH_IMAGER})"; \
      echo "none (not bundled)" > /etc/imager-version; \
      exit 0; \
    fi; \
    echo "${IMAGER_VERSION} (unresolved)" > /etc/imager-version; \
    cd /tmp; \
    curl -fSL --retry 3 --connect-timeout 20 "${IMAGER_URL}/imager-${IMAGER_VERSION}.tgz" -o imager-dl.tgz; \
    set +o pipefail; IMDIR="$(tar tzf imager-dl.tgz | head -n 1 | cut -d/ -f1)"; set -o pipefail; \
    case "${IMDIR}" in imager-src-*) ;; *) echo "ERROR: unexpected imager top dir ${IMDIR}" >&2; exit 1;; esac; \
    echo "${IMDIR#imager-src-}" > /etc/imager-version; \
    tar xzf imager-dl.tgz -C /; rm -f imager-dl.tgz; \
    for _p in musl-sysc-cache musl-unistd musl-sighandler clic-ungate sic-foreground; do \
      if [ "$_p" = "clic-ungate" ] && [ ! -f packages/clic/Makefile ]; then \
        echo "SKIP ${_p} (no clic package in this tree)" >&2; continue; \
      fi; \
      (cd "/${IMDIR}" && patch -p1 --forward < "/tmp/patches/${_p}.patch") || { echo "ERROR: patch ${_p} failed (IMAGER tree)" >&2; exit 1; }; \
    done; \
    IMDIR="${IMDIR}" JOBS="${MAKE_JOBS:-$(nproc)}" bash -c ' \
      set -ex -o pipefail; \
      unset gagsrcdir gagexedir gagadmdir || true; \
      cd "/${IMDIR}"; \
      cd Admin-Source && source substitute.compile.sh && cd ..; \
      GAG_SEARCH_PATH=/usr/lib source admin/imager-env.sh -o openmp; \
      export gagexedir=/imager-exe; \
      make -j "${JOBS}" && make install; \
    '; \
    rm -rf "/${IMDIR}"


FROM gildas_worker AS gildas

ARG release
ENV release=${release}
ARG IMAGER_VERSION=last
ENV IMAGER_VERSION=${IMAGER_VERSION}
ARG WITH_IMAGER=1

COPY --from=builder /gildas-exe-$release /gildas-exe-$release
COPY --from=builder /imager-exe /imager-exe
COPY --from=builder /etc/imager-version /etc/imager-version

SHELL ["/bin/bash", "-c"]

# Do not hardcode x86_64-alpineX.Y (musl layout differs from glibc):
# detect at build time, re-resolve at container start. The shared script
# also writes /etc/gildas-env.sh and the IMAGER/PIIC wrappers. Bind-mount
# it so the helper does not end up in the runtime image.
RUN --mount=type=bind,source=scripts/gildas-runtime.sh,target=/tmp/gildas-runtime.sh \
    RELEASE="$release" \
    FALLBACK_EXEC=x86_64-generic \
    EXEC_GREP='gfortran-openmp|gfortran|generic|musl|alpine' \
    RERESOLVE=1 \
    sh /tmp/gildas-runtime.sh env
RUN --mount=type=bind,source=scripts/gildas-runtime.sh,target=/tmp/gildas-runtime.sh \
    RELEASE="$release" \
    FALLBACK_EXEC=x86_64-generic \
    EXEC_GREP='gfortran-openmp|gfortran|generic|musl|alpine' \
    sh /tmp/gildas-runtime.sh imager
COPY docker/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && echo "none (not bundled)" > /etc/piic-version

LABEL org.opencontainers.image.title="GILDAS (alpine)" \
      org.opencontainers.image.revision="${release}" \
      abeelen.gildas.release="${release}" \
      abeelen.gildas.base="alpine" \
      abeelen.gildas.target="gildas" \
      abeelen.gildas.imager-version="${IMAGER_VERSION}" \
      abeelen.gildas.imager-bundled="${WITH_IMAGER}"
# NOTE: /etc/imager-version and /etc/piic-version inside the image are
# authoritative for bundled component versions (labels record build args).

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["bash"]


FROM gildas AS gildas-piic

ARG release
ENV release=${release}
ARG PIIC_URL=https://www.iram.fr/~gildas/dist
ENV PIIC_URL=$PIIC_URL
ARG PIIC_VERSION=${release}
ARG WITH_PIIC=1

WORKDIR /

RUN set -eu -o pipefail; \
    if [ "${WITH_PIIC}" != "1" ]; then \
      echo "Skipping PIIC (WITH_PIIC=${WITH_PIIC})" >&2; \
      echo "none (not bundled)" > /etc/piic-version; \
    elif curl -fSL --retry 3 --connect-timeout 20 "$PIIC_URL/piic-exe-$release.tar.xz" -o "/tmp/piic-exe-$release.tar.xz"; then \
      tar xJf "/tmp/piic-exe-$release.tar.xz" && rm -f "/tmp/piic-exe-$release.tar.xz"; \
      echo "$release" > /etc/piic-version; \
    else \
      echo "WARNING: no piic-exe-$release.tar.xz at $PIIC_URL, skipping PIIC layer" >&2; \
      echo "none (not bundled)" > /etc/piic-version; \
    fi

SHELL ["/bin/bash", "-c"]

# Direct-access wrappers for the PIIC tree; the shared script keeps the
# same never-shadow rule as the Docker gildas stage and the native recipe.
RUN --mount=type=bind,source=scripts/gildas-runtime.sh,target=/tmp/gildas-runtime.sh \
    RELEASE="$release" \
    FALLBACK_EXEC=x86_64-generic \
    EXEC_GREP='gfortran-openmp|gfortran|generic|musl|alpine' \
    sh /tmp/gildas-runtime.sh piic

LABEL abeelen.gildas.target="gildas-piic" \
      abeelen.gildas.piic-version="${PIIC_VERSION}" \
      abeelen.gildas.piic-bundled="${WITH_PIIC}"
